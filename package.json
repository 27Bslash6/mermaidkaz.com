{
  "name": "mermaidkaz",
  "version": "1.0.0",
  "description": "Tasmania's First PADI Mermaid Instructor - Professional mermaid courses and entertainment services",
  "main": "index.js",
  "scripts": {
    "start": "eleventy --serve --watch",
    "build": "eleventy",
    "build:prod": "NODE_ENV=production eleventy",
    "clean": "rm -rf _site",
    "test": "bun run test:html && bun run test:accessibility && bun run test:worker",
    "test:html": "html-validate \"_site/**/*.html\"",
    "test:accessibility": "node scripts/test-a11y.js",
    "design:verify": "bun run build && bun run design:drift && bunx playwright test",
    "design:drift": "node scripts/check-token-drift.js",
    "design:update": "bun run build && bunx playwright test --update-snapshots",
    "debug": "DEBUG=Eleventy* eleventy",
    "format": "prettier --write .",
    "lint": "eslint src/**/*.js",
    "optimize:images": "eleventy --config=optimize-images.js",
    "dev": "bun start",
    "preview": "bun run build && bunx http-server _site -p 8080 -o",
    "install:clean": "rm -rf node_modules bun.lockb && bun install",
    "verify:bun": "bun --version && echo '✅ Bun is working!' && bun run build --quiet && echo '✅ Build successful with Bun!'",
    "test:worker": "bun scripts/test-worker.js"
  },
  "keywords": [
    "mermaid",
    "padi",
    "instructor",
    "tasmania",
    "aquatic",
    "entertainment",
    "courses",
    "retreats",
    "swimming",
    "water-safety"
  ],
  "author": "Kaz - Tasmania's First PADI Mermaid Instructor",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/username/mermaidkaz.git"
  },
  "homepage": "https://www.mermaidkaz.com",
  "engines": {
    "node": ">=18.0.0",
    "bun": ">=1.0.0"
  },
  "dependencies": {
    "@11ty/eleventy": "^2.0.1",
    "@11ty/eleventy-img": "^4.0.2",
    "@11ty/eleventy-navigation": "^0.3.5",
    "@11ty/eleventy-plugin-rss": "^1.2.0",
    "@11ty/eleventy-plugin-syntaxhighlight": "^5.0.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@fontsource/marck-script": "^5.3.0",
    "@sveltia/cms": "^0.181.1",
    "html-minifier": "^4.0.0",
    "markdown-it": "^14.1.0",
    "markdown-it-anchor": "^8.6.7",
    "markdown-it-attrs": "^4.1.6",
    "nunjucks": "^3.2.4",
    "sharp": "^0.33.4",
    "slugify": "^1.6.6"
  },
  "devDependencies": {
    "@axe-core/cli": "^4.8.5",
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@types/bun": "latest",
    "eslint": "^8.57.0",
    "html-validate": "^8.18.1",
    "lighthouse": "^11.7.0",
    "pa11y-ci": "^3.1.0",
    "prettier": "^3.2.5",
    "rimraf": "^5.0.7"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie <= 11"
  ],
  "funding": {
    "type": "individual",
    "url": "https://www.mermaidkaz.com/contact"
  },
  "bun": {
    "install": {
      "production": false,
      "optional": true,
      "dev": true,
      "peer": true
    },
    "run": {
      "bun": true
    }
  },
  "trustedDependencies": [
    "@11ty/eleventy",
    "chromedriver",
    "puppeteer",
    "sharp"
  ],
  "private": true,
  "peerDependencies": {
    "typescript": "^5"
  }
}
