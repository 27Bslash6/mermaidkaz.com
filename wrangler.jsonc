// Cloudflare Workers static-assets deploy (replaces the legacy Pages projects — LAB-87).
// Production worker: mermaidkaz. Staging worker: mermaidkaz-staging (--env staging).
// PR previews: `wrangler versions upload` → per-version preview URL (needs preview_urls).
{
  "name": "mermaidkaz",
  "compatibility_date": "2026-07-16",
  "main": "worker/index.js",
  "assets": {
    "directory": "_site",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },
  "workers_dev": true,
  "preview_urls": true,
  // Production custom domain (LAB-86). Cloudflare manages the DNS record + cert
  // for the attach; fnord.lol is a zone in this account. Named envs do not
  // inherit routes, so staging stays on workers.dev only.
  "routes": [
    {
      "pattern": "mermaid.fnord.lol",
      "custom_domain": true
    }
  ],
  "env": {
    "staging": {
      "name": "mermaidkaz-staging",
      "workers_dev": true
    }
  }
}
