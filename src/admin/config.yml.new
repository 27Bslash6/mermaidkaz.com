backend:
  name: github
  repo: 27Bslash6/mermaidkaz.com
  branch: main
  squash_merges: true
# Local development
local_backend: true
# Media management
media_folder: "src/assets/images/uploads"
public_folder: "/assets/images/uploads"
# Site configuration
site_url: https://mermaidkaz.pages.dev
display_url: https://mermaidkaz.pages.dev
logo_url: https://mermaidkaz.pages.dev/assets/images/logo.svg
# Editorial workflow
publish_mode: editorial_workflow
show_preview_links: true
# Collections
collections:
  # Site settings
  - name: "settings"
    label: "Site Settings"
    files:
      - name: "general"
        label: "General Settings"
        file: "src/_data/site.json"
        fields:
          - { label: "Site Title", name: "title", widget: "string" }
          - { label: "Site Tagline", name: "tagline", widget: "string" }
          - { label: "Site Description", name: "description", widget: "text" }
          - { label: "Site URL", name: "url", widget: "string" }
          - label: "Author"
            name: "author"
            widget: "object"
            fields:
              - { label: "Name", name: "name", widget: "string" }
              - { label: "Email", name: "email", widget: "string" }
          - label: "Social Media"
            name: "social"
            widget: "object"
            fields:
              - { label: "Instagram URL", name: "instagram", widget: "string" }
              - { label: "Facebook URL", name: "facebook", widget: "string" }
              - {
                  label: "TikTok URL",
                  name: "tiktok",
                  widget: "string",
                  required: false,
                }
              - {
                  label: "YouTube URL",
                  name: "youtube",
                  widget: "string",
                  required: false,
                }
          - label: "Contact Information"
            name: "contact"
            widget: "object"
            fields:
              - { label: "Email", name: "email", widget: "string" }
              - { label: "Phone", name: "phone", widget: "string" }
              - { label: "Location", name: "location", widget: "string" }
          - label: "Booking"
            name: "booking"
            widget: "object"
            fields:
              - { label: "TidyCal URL", name: "tidycal_url", widget: "string" }
  # Pages
  - name: "pages"
    label: "Pages"
    files:
      - name: "home"
        label: "Home Page"
        file: "src/index.md"
        fields:
          - { label: "Title", name: "title", widget: "string" }
          - { label: "Description", name: "description", widget: "text" }
          - {
              label: "Layout",
              name: "layout",
              widget: "hidden",
              default: "page",
            }
          - label: "Hero Section"
            name: "hero"
            widget: "object"
            fields:
              - { label: "Title", name: "title", widget: "string" }
              - { label: "Subtitle", name: "subtitle", widget: "string" }
              - { label: "Hero Image", name: "image", widget: "image" }
              - {
                  label: "Hero Image Alt Text",
                  name: "imageAlt",
                  widget: "string",
                }
              - label: "Call to Action"
                name: "cta"
                widget: "object"
                fields:
                  - { label: "Button Text", name: "text", widget: "string" }
                  - { label: "Button URL", name: "url", widget: "string" }
          - { label: "Content", name: "body", widget: "markdown" }
      - name: "about"
        label: "About Page"
        file: "src/about.md"
        fields:
          - { label: "Title", name: "title", widget: "string" }
          - { label: "Description", name: "description", widget: "text" }
          - {
              label: "Layout",
              name: "layout",
              widget: "hidden",
              default: "page",
            }
          - {
              label: "Hero Image",
              name: "hero_image",
              widget: "image",
              required: false,
            }
          - {
              label: "Hero Alt Text",
              name: "hero_alt",
              widget: "string",
              required: false,
            }
          - { label: "Content", name: "body", widget: "markdown" }
      - name: "services"
        label: "Services Page"
        file: "src/services.md"
        fields:
          - { label: "Title", name: "title", widget: "string" }
          - { label: "Description", name: "description", widget: "text" }
          - {
              label: "Layout",
              name: "layout",
              widget: "hidden",
              default: "page",
            }
          - { label: "Content", name: "body", widget: "markdown" }
      - name: "contact"
        label: "Contact Page"
        file: "src/contact.md"
        fields:
          - { label: "Title", name: "title", widget: "string" }
          - { label: "Description", name: "description", widget: "text" }
          - {
              label: "Layout",
              name: "layout",
              widget: "hidden",
              default: "page",
            }
          - { label: "Content", name: "body", widget: "markdown" }
  # Individual Services
  - name: "individual_services"
    label: "Individual Services"
    folder: "src/services"
    create: true
    slug: "{{slug}}"
    fields:
      - { label: "Title", name: "title", widget: "string" }
      - { label: "Description", name: "description", widget: "text" }
      - {
          label: "Layout",
          name: "layout",
          widget: "hidden",
          default: "service",
        }
      - { label: "Service Image", name: "image", widget: "image" }
      - { label: "Image Alt Text", name: "image_alt", widget: "string" }
      - { label: "Price", name: "price", widget: "string" }
      - { label: "Duration", name: "duration", widget: "string" }
      - {
          label: "PADI Certification",
          name: "certification",
          widget: "string",
          required: false,
        }
      - { label: "Group Size", name: "group_size", widget: "string" }
      - {
          label: "Difficulty Level",
          name: "difficulty",
          widget: "select",
          options: ["Beginner", "Intermediate", "Advanced", "All Levels"],
        }
      - label: "Features"
        name: "features"
        widget: "list"
        field: { label: "Feature", name: "feature", widget: "string" }
      - {
          label: "Booking URL",
          name: "booking_url",
          widget: "string",
          required: false,
        }
      - { label: "Order", name: "order", widget: "number", default: 1 }
      - {
          label: "Featured",
          name: "featured",
          widget: "boolean",
          default: false,
        }
      - { label: "Content", name: "body", widget: "markdown" }
      - { label: "Tags", name: "tags", widget: "hidden", default: ["service"] }
  # Testimonials
  - name: "testimonials"
    label: "Testimonials"
    folder: "src/testimonials"
    create: true
    slug: "{{slug}}"
    fields:
      - { label: "Name", name: "title", widget: "string" }
      - { label: "Quote", name: "quote", widget: "text" }
      - { label: "Author Name", name: "author", widget: "string" }
      - {
          label: "Author Role/Title",
          name: "role",
          widget: "string",
          required: false,
        }
      - {
          label: "Author Photo",
          name: "photo",
          widget: "image",
          required: false,
        }
      - { label: "Date", name: "date", widget: "datetime" }
      - {
          label: "Rating",
          name: "rating",
          widget: "number",
          min: 1,
          max: 5,
          default: 5,
        }
      - {
          label: "Featured",
          name: "featured",
          widget: "boolean",
          default: false,
        }
      - {
          label: "Service Type",
          name: "service_type",
          widget: "string",
          required: false,
        }
      - {
          label: "Tags",
          name: "tags",
          widget: "hidden",
          default: ["testimonial"],
        }
  # Blog/News (optional)
  - name: "blog"
    label: "Blog Posts"
    folder: "src/blog"
    create: true
    slug: "{{year}}-{{month}}-{{day}}-{{slug}}"
    fields:
      - { label: "Title", name: "title", widget: "string" }
      - { label: "Description", name: "description", widget: "text" }
      - { label: "Author", name: "author", widget: "string", default: "Kaz" }
      - { label: "Date", name: "date", widget: "datetime" }
      - {
          label: "Featured Image",
          name: "image",
          widget: "image",
          required: false,
        }
      - {
          label: "Image Alt Text",
          name: "image_alt",
          widget: "string",
          required: false,
        }
      - { label: "Layout", name: "layout", widget: "hidden", default: "post" }
      - { label: "Draft", name: "draft", widget: "boolean", default: false }
      - {
          label: "Featured",
          name: "featured",
          widget: "boolean",
          default: false,
        }
      - label: "Tags"
        name: "tags"
        widget: "list"
        allow_add: true
        field: { label: "Tag", name: "tag", widget: "string" }
      - { label: "Content", name: "body", widget: "markdown" }
# Editor settings
editor:
  preview: true
# Configuration updated to use GitHub backend