{#- Emits ONE contiguous HTML block (no blank lines): callers include this
    from markdown, and a blank line would end markdown-it's raw-HTML block
    and get the rest paragraph-wrapped (<p><li>…). Keep the trims. -#}
<article class="service-card">
  {%- if service.image %}
  <div class="service-image">
    {%- image service.image, service.imageAlt or service.title, "service-img", "(max-width: 768px) 100vw, 400px" %}
  </div>
  {%- endif %}
  <div class="service-content">
    <h3>{{ service.title }}</h3>
    {%- if service.duration %}
    <p class="service-duration"><strong>Duration:</strong> {{ service.duration }}</p>
    {%- endif %}
    {%- if service.price %}
    <p class="service-price"><strong>Price:</strong> {{ service.price }}</p>
    {%- endif %}
    {%- if service.description %}
    <p class="service-description">{{ service.description }}</p>
    {%- endif %}
    {%- if service.features %}
    <ul class="service-features">
      {%- for feature in service.features %}
      <li>{{ feature }}</li>
      {%- endfor %}
    </ul>
    {%- endif %}
    {%- if service.cta or service.eventbriteKey %}
    <div class="service-cta">
      {%- if service.eventbriteKey %}{% set ebKey = service.eventbriteKey %}{% include "eventbrite-button.njk" %}{% endif %}
      {%- if service.cta %}
      <a href="{{ service.cta.url }}" class="button {{ service.cta.class or 'button-primary' }}">{{ service.cta.text }}</a>
      {%- endif %}
    </div>
    {%- endif %}
  </div>
</article>
