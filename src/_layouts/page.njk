---
layout: base
---

{% block content %}
{% if hero %}
<section class="hero {{ hero.class if hero.class }}">
  <div class="container">
    {% if hero.image %}
      <div class="hero-image">
        {% heroImage hero.image, hero.imageAlt or title, "hero-img" %}
      </div>
    {% endif %}
    
    <div class="hero-content">
      {% if hero.title %}
        <h1>{{ hero.title }}</h1>
      {% else %}
        <h1>{{ title }}</h1>
      {% endif %}
      
      {% if hero.subtitle %}
        <p class="hero-subtitle">{{ hero.subtitle }}</p>
      {% endif %}
      
      {% if hero.cta %}
        <div class="hero-cta">
          <a href="{{ hero.cta.url }}" class="button button-primary">
            {{ hero.cta.text }}
          </a>
        </div>
      {% endif %}
    </div>
  </div>
</section>
{% else %}
<section class="page-header">
  <div class="container">
    <h1>{{ title }}</h1>
    {% if subtitle %}
      <p class="subtitle">{{ subtitle }}</p>
    {% endif %}
  </div>
</section>
{% endif %}

<section class="page-content">
  <div class="container">
    {{ content | safe }}
  </div>
</section>
{% endblock %}