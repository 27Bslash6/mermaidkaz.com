<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="{{ description or site.description }}">
  <meta name="author" content="{{ site.author.name }}">
  <meta name="generator" content="{{ eleventy.generator }}">

  <title>{% if title %}{{ title }} | Mermaid Kaz{% else %}{{ site.title }}{% endif %}</title>

  {# Self-hosted fonts + token contract arrive via main.css @imports — no CDN. #}
  <link rel="stylesheet" href="/assets/css/main.css">

  <link rel="icon" type="image/x-icon" href="/favicon.ico">

  <!-- Social Media & SEO -->
  {% if socialMeta %}
    {% socialMeta {
      title: title or site.title,
      description: description or site.description,
      image: socialImage or site.socialImage,
      url: site.url + page.url
    } %}
  {% endif %}

  {% if structuredData %}
    {% structuredData structuredData %}
  {% endif %}

  {# --color-t0 from tokens.css — meta tags can't consume CSS custom properties #}
  <meta name="theme-color" content="#e8f7f7">

</head>
<body class="{{ bodyClass if bodyClass }}">
  {% skipLink "main-content" %}

  <header class="site-header">
    <nav class="container site-nav" aria-label="Main navigation">
      <a href="/" class="brand">
        <img src="/assets/images/logo.png" alt="Mermaid Kaz" width="500" height="500">
      </a>
      <ul class="site-nav-links">
        {% for item in navigation.main %}
          <li>
            <a href="{{ item.url }}"
               {% if item.highlight %}class="button button-primary nav-cta"{% endif %}
               {% if page.url == item.url and not item.highlight %}aria-current="page"{% endif %}
               {% if item.external %}target="_blank" rel="noopener noreferrer"{% endif %}>
              {{ item.text }}
            </a>
          </li>
        {% endfor %}
      </ul>
      <button type="button" class="mobile-menu-toggle" aria-label="Toggle navigation menu" aria-expanded="false">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </nav>
  </header>

  <main id="main-content" tabindex="-1">
    {{ content | safe }}
  </main>

  {% set waveClass = "wave--deep" %}
  {% include "wave.njk" %}

  <footer class="site-footer">
    <div class="container">
      <div class="footer-content">
        <div class="footer-section">
          <p class="footer-brand">Mermaid Kaz</p>
          <p>Tasmania's first PADI Mermaid Instructor</p>
          <p class="footer-tagline">{{ site.tagline }}</p>
        </div>

        <div class="footer-section">
          <h2>Explore</h2>
          <ul>
            {% for item in navigation.footer %}
              <li>
                <a href="{{ item.url }}"
                   {% if item.external %}target="_blank" rel="noopener noreferrer"{% endif %}>
                  {{ item.text }}
                </a>
              </li>
            {% endfor %}
          </ul>
        </div>

        <div class="footer-section">
          <h2>Connect</h2>
          <ul class="social-links">
            {% for social in site.social %}
              <li>
                <a href="{{ social.url }}" target="_blank" rel="noopener noreferrer">
                  {%- set icon = social.icon -%}
                  {%- include "social-icon.njk" -%}
                  <span class="sr-only">{{ social.name }}</span>
                </a>
              </li>
            {% endfor %}
          </ul>
          <address>
            <p><a href="mailto:{{ site.contact.email }}">{{ site.contact.email }}</a></p>
            <p>{{ site.contact.location }}</p>
          </address>
        </div>
      </div>

      <div class="footer-bottom">
        <p>&copy; {{ currentYear }} Mermaid Kaz. All rights reserved.</p>
      </div>
    </div>
  </footer>

  <script src="/assets/js/main.js" defer></script>
</body>
</html>
